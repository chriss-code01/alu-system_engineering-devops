#!/usr/bin/env bash
# Configures nginx to run as the nginx user and listen on port 8080 on all IPs
sed -i 's/^user .*;/user nginx;/' /etc/nginx/nginx.conf
sed -i 's/80 default_server/8080 default_server/g; s/\[::\]:80/[::]:8080/g; s/listen 80;/listen 8080;/g' /etc/nginx/sites-enabled/default
chmod 644 /etc/nginx/nginx.conf
pkill -9 nginx
sudo -u nginx service nginx start
