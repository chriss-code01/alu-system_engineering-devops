#!/usr/bin/env bash
# Installs and configures HAProxy to round-robin traffic between web-01 and web-02
apt-get update -y
apt-get install -y haproxy

# Allow the init script to start HAProxy (needed on older packages)
if [ -f /etc/default/haproxy ]; then
    sed -i 's/^ENABLED=.*/ENABLED=1/' /etc/default/haproxy
fi

cat > /etc/haproxy/haproxy.cfg << 'EOF'
global
    maxconn 2048
    user haproxy
    group haproxy
    daemon

defaults
    mode http
    option forwardfor
    timeout connect 5000ms
    timeout client  50000ms
    timeout server  50000ms

frontend http-in
    bind *:80
    default_backend web-backend

backend web-backend
    balance roundrobin
    server web-01 35.178.147.142:80 check
    server web-02 16.60.178.95:80 check
EOF

service haproxy restart
