#!/usr/bin/env bash
# Configures Nginx with the web server requirements and custom response header

set -e

apt-get update -y
apt-get install -y nginx

HOSTNAME=$(hostname)
CONFIG=/etc/nginx/sites-available/default

printf '%s\n' "Holberton School for the win!" > /var/www/html/index.html
printf "%s\n" "Ceci n'est pas une page" > /var/www/html/404.html

if ! grep -q "location /redirect_me" "$CONFIG"; then
    sed -i '/listen 80 default_server;/a\    location /redirect_me { return 301 https://www.youtube.com/watch?v=QH2-TGUlwu4; }' "$CONFIG"
fi

if ! grep -q "error_page 404" "$CONFIG"; then
    sed -i '/listen 80 default_server;/a\    error_page 404 /404.html;' "$CONFIG"
fi

if ! grep -q "X-Served-By" "$CONFIG"; then
    sed -i "/listen 80 default_server;/a\\    add_header X-Served-By $HOSTNAME;" "$CONFIG"
fi

nginx -t
service nginx restart
